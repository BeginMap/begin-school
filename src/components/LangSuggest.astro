---
// First visit only: if the browser language is ar / ru / en (and differs from this page), offer — never redirect.
import { LANGS, NATIVE, DIR, t, href, type Lang, type Page } from '../i18n';
interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const offers = LANGS.filter((l) => l !== lang).map((l) => ({ l, url: href(l, page), text: t(l).ui.suggest, yes: t(l).ui.suggestYes, no: t(l).ui.suggestNo }));
---
<div class="ls" data-lang-suggest hidden>
  {offers.map((o) => (
    <div class="ls__card" data-offer={o.l} lang={o.l} dir={DIR[o.l]} hidden role="region" aria-label={NATIVE[o.l]}>
      <p class="ls__text">{o.text}</p>
      <div class="ls__acts">
        <a class="btn ls__yes" href={o.url} data-lang-link={o.l}><span>{o.yes}</span></a>
        <button class="ls__no" type="button" data-suggest-close>{o.no}</button>
      </div>
    </div>
  ))}
</div>

<style>
  .ls {
    position: fixed;
    inset-inline: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .ls__card {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    max-width: 560px;
    padding: 14px 16px 14px 20px;
    background: #f2f0eb;
    color: #141413;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    --fg: #141413;
    --focus: #141413;
    animation: ls-in var(--dur-3) var(--ease-focus);
  }
  @keyframes ls-in { from { opacity: 0; transform: translateY(20px); filter: blur(6px); } }
  .ls__text { margin: 0; font-weight: 500; }
  .ls__acts { display: flex; gap: 8px; align-items: center; margin-inline-start: auto; }
  .ls__yes { min-height: 44px; padding-block: 0.45em; }
  .ls__no {
    min-height: 44px;
    min-width: 44px;
    padding-inline: 12px;
    border: 0;
    background: transparent;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
