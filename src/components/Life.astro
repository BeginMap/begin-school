---
import { t, type Lang } from '../i18n';
import { FLAGS } from '../data/facts';
import { PHOTO_BY_ID } from '../data/photos';
import { TESTIMONIALS } from '../data/testimonials';
import Photo from './Photo.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
// order = rhythm: wide / tall alternate. Facebook photos drop out at once when FLAGS.fbPhotos is off.
const strip = [
  { id: 'ev-8', k: 'tall' }, { id: 'hall-2', k: 'tall' }, { id: 'htb-2', k: 'wide' }, { id: 'eshkol-1', k: 'tall' },
  { id: 'court-3', k: 'wide' }, { id: 'ev-6', k: 'wide' }, { id: 'htb-3', k: 'tall' }, { id: 'hall-3', k: 'wide' },
  { id: 'court-2', k: 'wide' }, { id: 'eshkol-2', k: 'tall' }, { id: 'hall-4', k: 'wide' }, { id: 'ev-1', k: 'tall' },
  { id: 'htb-1', k: 'tall' }, { id: 'eshkol-4', k: 'wide' }, { id: 'wall-music', k: 'wide' }, { id: 'yard-5', k: 'wide' },
].filter((p) => FLAGS.fbPhotos || !PHOTO_BY_ID[p.id].fb);
const boards = ['board-art', 'board-music', 'board-books', 'board-sport'];
const quotes = TESTIMONIALS.filter((q) => q.lang === lang);
---
<section class="sec life" id="life" data-field="life" aria-labelledby="life-title">
  <div class="wrap life__head scrim">
    <h2 id="life-title" class="h2" data-kt>{d.life.title}</h2>
    <p class="lead">{d.life.lead}</p>
  </div>

  <div class="life__strip" data-life tabindex="0" role="region" aria-label={d.life.title}>
    <ul class="life__list" role="list">
      {strip.map((p) => (
        <li class={`life__item life__item--${p.k}`} data-life-item>
          <Photo id={p.id} lang={lang} caption credit sizes={p.k === 'tall' ? '(max-width: 760px) 70vw, 30vw' : '(max-width: 760px) 86vw, 48vw'} focus={false} />
        </li>
      ))}
    </ul>
  </div>
  <div class="wrap life__ctrl">
    <span class="small muted">{d.life.drag}</span>
    <div class="life__btns">
      <button type="button" class="btn life__btn" data-life-prev aria-label={d.ui.prev}><svg class="flip" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
      <button type="button" class="btn life__btn" data-life-next aria-label={d.ui.next}><svg class="flip" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
    </div>
  </div>

  <div class="wrap life__boards">
    <div class="boards">
      {boards.map((id) => <Photo id={id} lang={lang} class="board" sizes="(max-width: 760px) 46vw, 24vw" />)}
    </div>
    <div class="life__notes">
      <p class="life__note">{d.life.boards}</p>
      <p class="life__note muted small" data-unverified>{d.life.arts}</p>
    </div>
  </div>

  {FLAGS.testimonials && quotes.length > 0 && (
    <div class="wrap life__quotes">
      {quotes.map((q) => <blockquote class="quote"><p>{q.text}</p><footer class="small muted">{q.who}</footer></blockquote>)}
    </div>
  )}
</section>

<style>
  .life { padding-bottom: clamp(64px, 10vh, 120px); }
  .life__head { max-width: 44rem; margin-bottom: clamp(32px, 6vh, 64px); }
  .life__head .lead { margin-top: 1em; }
  .life__strip {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 8px 12px;
  }
  .life__strip::-webkit-scrollbar { display: none; }
  .life__strip:focus-visible { outline-offset: -3px; }
  .life__list {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 28px);
    width: max-content;
    padding-inline: var(--pad);
  }
  .life__item { scroll-snap-align: center; transition: opacity var(--dur-3) var(--ease-focus), transform var(--dur-3) var(--ease-focus); }
  .life__item--tall { width: clamp(220px, 26vw, 380px); }
  .life__item--wide { width: clamp(300px, 44vw, 640px); }
  .life__item--tall :global(.ph) { aspect-ratio: 3 / 4; }
  .life__item--wide :global(.ph) { aspect-ratio: 3 / 2; }
  .life__item :global(.ph img) { transition: opacity var(--dur-3) var(--ease-focus); }
  .life__item :global(.ph) { background-color: var(--g2); }
  .life__item :global(figcaption) { padding-top: 10px; max-width: 40ch; }
  :global(html.js[data-motion='on']) .life__strip.is-live .life__item:not(.is-center) { opacity: 0.7; transform: scale(0.94); }
  :global(html.js[data-motion='on']) .life__strip.is-live .life__item:not(.is-center) :global(.ph img) { opacity: 0.55; }
  .life__ctrl { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 8px; }
  .life__btns { display: flex; gap: 8px; }
  .life__btn { width: 52px; padding: 0; justify-content: center; }
  .life__boards {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--gap);
    align-items: end;
    margin-top: clamp(56px, 9vh, 110px);
  }
  .boards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .boards :global(.board) { aspect-ratio: 2 / 1; }
  .life__note { max-width: 34ch; }
  .life__quotes { margin-top: 64px; display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .quote { margin: 0; font-size: var(--fs-lead); }
  @media (max-width: 760px) { .life__boards { grid-template-columns: 1fr; } }
</style>
