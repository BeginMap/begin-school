---
import { t, type Lang } from '../i18n';
import campus from '../data/campus.json';
import { LINKS } from '../data/facts';
import Photo from './Photo.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
type G = keyof typeof d.names.groups;
const groups = Object.keys(d.names.groups) as G[];
const N = campus.names as Record<G, { he: string; ru: string; en: string; id: string }[]>;
const meaning = (id: string) => (d.names.meanings as Record<string, string>)[id];
const translit = (n: { ru: string; en: string }) => (lang === 'ru' ? n.ru : lang === 'en' ? n.en : '');
---
<section class="sec sec--light names" id="names" data-field="names" aria-labelledby="names-title">
  <div class="wrap names__head">
    <h2 id="names-title" class="h2" data-kt>{d.names.title}</h2>
    <p class="lead">{d.names.lead}</p>
    <p class="names__hint small muted">{d.names.hint}</p>
  </div>

  <div class="names__rows" data-names>
    {groups.map((g, gi) => (
      <div class="nrow" data-nrow style={`--dir:${gi % 2 ? -1 : 1}`}>
        <h3 class="nrow__title wrap">{d.names.groups[g]}</h3>
        <ul class="nrow__list" role="list">
          {N[g].map((n, i) => (
            <li class="nm-item">
              <details class="nm" data-nm={n.id}>
                <summary class:list={['nm__name', i % 3 === 1 && 'nm__name--light']} lang="he" dir="rtl">{n.he}</summary>
                <div class="nm__info">
                  {translit(n) && <p class="nm__tr">{translit(n)}</p>}
                  <p class="nm__mean">{meaning(n.id)}</p>
                  <a class="nm__map" href={`${LINKS.beginMap}?to=${n.id}`} rel="noopener">{d.names.showOnMap}</a>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="wrap names__figs">
    <figure class="names__door">
      <Photo id="door-dolphin" lang={lang} sizes="(max-width: 760px) 92vw, 56vw" />
      <figcaption class="cap">{d.names.doorCaption}</figcaption>
    </figure>
    <figure class="names__plaques">
      <div class="plaques">
        {['plaque-kalanit', 'plaque-iris', 'plaque-narkis', 'plaque-hatzav', 'plaque-tzivoni'].map((id) => (
          <Photo id={id} lang={lang} sizes="160px" class="plaque" />
        ))}
      </div>
      <figcaption class="cap">{d.names.plaquesCaption}</figcaption>
    </figure>
  </div>

  <div class="nm-pop" data-nm-pop hidden role="dialog" aria-modal="false" aria-labelledby="nm-pop-name">
    <p id="nm-pop-name" class="nm-pop__name" lang="he" dir="rtl"></p>
    <p class="nm-pop__tr"></p>
    <p class="nm-pop__mean"></p>
    <a class="nm-pop__map" href="#" rel="noopener">{d.names.showOnMap}</a>
    <button type="button" class="nm-pop__x" data-nm-close aria-label={d.ui.close}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" fill="none"/></svg>
    </button>
  </div>
</section>

<style>
  .names { overflow: clip; }
  .names__head { margin-bottom: clamp(40px, 7vh, 80px); }
  .names__head .lead { margin-top: 1em; max-width: 42ch; }
  .names__hint { margin-top: 1em; }
  .nrow { padding-block: clamp(8px, 1.4vh, 16px); border-top: 1px solid var(--line); }
  .nrow:last-child { border-bottom: 1px solid var(--line); }
  .nrow__title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--fg-muted);
    margin-bottom: 4px;
  }
  .nrow__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(16px, 2.4vw, 40px);
    padding-inline: var(--pad);
    max-width: calc(var(--max) + 2 * var(--pad));
    margin-inline: auto;
  }
  .nm-item { position: relative; }
  .nm__name {
    display: inline-block;
    list-style: none;
    cursor: pointer;
    font-size: clamp(2.2rem, 1.2rem + 5vw, 6rem);
    font-weight: 900;
    font-style: italic;
    line-height: 1.12;
    padding-block: 2px;
    border-radius: 4px;
    transition: color var(--dur-1) linear;
  }
  .nm__name--light { font-weight: 300; }
  .nm__name::-webkit-details-marker { display: none; }
  .nm__name:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.12em; }
  .nm[open] .nm__name { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.12em; }
  .nm__info {
    padding: 4px 0 16px;
    max-width: 30ch;
  }
  .nm__info p { margin: 0 0 4px; }
  .nm__tr { font-weight: 700; }
  .nm__mean { color: var(--fg-muted); }
  .nm__map, .nm-pop__map { display: inline-flex; min-height: 40px; align-items: center; font-weight: 600; }

  /* moving rows (JS + motion): single line, slid by scroll; details content shown in a popover instead */
  :global(.names__rows.is-moving) .nrow__list { flex-wrap: nowrap; width: max-content; max-width: none; will-change: transform; }
  :global(.names__rows.is-moving) .nm__info { display: none; }

  .nm-pop {
    position: absolute;
    z-index: 5;
    width: min(320px, calc(100vw - 32px));
    padding: 16px 44px 14px 18px;
    background: var(--ink);
    color: #efede8;
    border-radius: 12px;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.35);
    --focus: #efede8;
    animation: pop-in var(--dur-2) var(--ease-focus);
  }
  [dir='rtl'] .nm-pop { padding: 16px 18px 14px 44px; }
  @keyframes pop-in { from { opacity: 0; transform: translateY(6px) scale(0.97); filter: blur(4px); } }
  .nm-pop p { margin: 0 0 4px; }
  .nm-pop__name { font-size: 1.6rem; font-weight: 800; font-style: italic; }
  .nm-pop__tr { font-weight: 700; }
  .nm-pop__tr:empty { display: none; }
  .nm-pop__mean { color: #c9c6bf; }
  .nm-pop__x {
    position: absolute;
    top: 6px;
    inset-inline-end: 6px;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border: 0; border-radius: 50%;
    background: transparent; color: inherit; cursor: pointer;
  }

  .names__figs {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gap);
    margin-top: clamp(48px, 8vh, 96px);
    align-items: end;
  }
  .names__figs figure { margin: 0; }
  .names__door :global(.ph) { aspect-ratio: 1152 / 512; }
  .plaques { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .plaques :global(.plaque) { aspect-ratio: 3 / 4; border-radius: 2px; }
  .names__figs .cap { padding-top: 8px; }
  @media (max-width: 760px) { .names__figs { grid-template-columns: 1fr; } }
</style>
