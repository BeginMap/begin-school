---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const grades = ['ו׳', 'ז׳', 'ח׳', 'ט׳', 'י׳', 'י״א', 'י״ב'];
---
<section class="sec years" id="years" data-field="years" aria-labelledby="years-title">
  <div class="wrap years__grid">
    <div class="years__text scrim">
      <h2 id="years-title" class="h2" data-kt>{d.years.title}</h2>
      <p class="lead">{d.years.lead}</p>
    </div>

    <div class="yrs" data-years>
      <ol class="yrs__list" role="list">
        {grades.map((g, i) => (
          <li class:list={['yr', i === 0 && 'yr--now', i === 1 && 'yr--next', i >= 1 && i <= 3 && 'yr--htb', i >= 4 && 'yr--hta']} style={`--i:${i}`}>
            <span class="yr__g" lang="he" dir="rtl">{g}</span>
            <span class="yr__s">{d.years.small[i]}</span>
            <span class="yr__line" aria-hidden="true"></span>
          </li>
        ))}
      </ol>
      <div class="yrs__marker" data-years-marker aria-hidden="true">
        <span class="yrs__dot"></span>
        <span class="yrs__lbl"><span class="yrs__now">{d.years.now}</span><span class="yrs__soon">{d.years.soon}</span></span>
      </div>
      <p class="visually-hidden">{d.years.now}: ו׳. {d.years.soon}: ז׳.</p>

      <div class="stage stage--1">
        <p class="stage__name">{d.years.stage1.name}</p>
        <p class="stage__sub">{d.years.stage1.sub}</p>
        <p class="stage__text">{d.years.stage1.text}</p>
      </div>
      <div class="stage stage--2">
        <p class="stage__name">{d.years.stage2.name}</p>
        <p class="stage__sub">{d.years.stage2.sub}</p>
        <p class="stage__text">{d.years.stage2.text}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .years__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .years__text { position: sticky; top: calc(var(--header-h) + 8vh); }
  .years__text .lead { margin-top: 1.2em; }

  .yrs {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    grid-template-rows: repeat(7, auto);
    column-gap: clamp(16px, 3vw, 40px);
  }
  .yrs__list { display: contents; }
  .yr {
    grid-column: 1;
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding-block: clamp(10px, 1.8vh, 20px) 10px;
  }
  .yr:nth-child(1) { grid-row: 1; }
  .yr:nth-child(2) { grid-row: 2; }
  .yr:nth-child(3) { grid-row: 3; }
  .yr:nth-child(4) { grid-row: 4; }
  .yr:nth-child(5) { grid-row: 5; }
  .yr:nth-child(6) { grid-row: 6; }
  .yr:nth-child(7) { grid-row: 7; }
  .yr__g {
    font-size: clamp(2.2rem, 1.4rem + 3.2vw, 4.4rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1;
    min-width: 2.2ch;
  }
  .yr__s { color: var(--fg-muted); font-size: var(--fs-small); }
  .yr__line {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--fg);
    transform-origin: var(--origin-start, left);
    opacity: 0.85;
  }
  [dir='rtl'] .yr__line { --origin-start: right; }
  .yr--now .yr__g { color: var(--fg-faint); }
  .yr--now .yr__line {
    background: none;
    border-bottom: 1.5px dashed var(--fg-faint);
    opacity: 1;
  }
  .yr--hta .yr__line { opacity: 0.5; }
  :global(html.story[data-motion='on']) .yrs:not(.is-drawn) .yr__line { transform: scaleX(0); }
  :global(html.story[data-motion='on']) .yrs .yr__line {
    transition: transform 1.1s var(--ease-focus);
    transition-delay: calc(var(--i) * 90ms);
  }

  .yrs__marker {
    position: absolute;
    inset-inline-end: calc(15rem + clamp(16px, 3vw, 40px));
    top: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translateY(var(--my, 30px));
    pointer-events: none;
  }
  .yrs__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--sail);
    box-shadow: 0 0 0 6px rgba(201, 54, 47, 0.22);
  }
  .yrs__lbl { position: relative; font-size: var(--fs-small); font-weight: 600; white-space: nowrap; }
  .yrs__soon { position: absolute; inset-inline-start: 0; top: 0; opacity: 0; }
  .yrs.is-moved .yrs__now { opacity: 0; }
  .yrs.is-moved .yrs__soon { opacity: 1; }
  .yrs__now, .yrs__soon { transition: opacity var(--dur-2) linear; }

  .stage {
    grid-column: 2;
    position: relative;
    align-self: stretch;
    padding-inline-start: 18px;
    padding-block: 14px;
    border-inline-start: 1.5px solid var(--fg);
  }
  .stage--1 { grid-row: 2 / span 3; }
  .stage--2 { grid-row: 5 / span 3; border-inline-start-color: var(--fg-faint); }
  .stage p { margin: 0; }
  .stage__name { font-weight: 700; font-size: 1.12rem; }
  .stage__sub { color: var(--fg-muted); font-size: var(--fs-small); margin-bottom: 0.6em !important; }
  .stage__text { color: var(--fg-muted); font-size: 0.98rem; line-height: 1.5; }

  @media (max-width: 860px) {
    .years__grid { grid-template-columns: 1fr; }
    .years__text { position: static; }
    .yrs { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .yrs__marker { inset-inline-end: 0; }
    .stage--1 { grid-column: 1; grid-row: 8; margin-top: 36px; }
    .stage--2 { grid-column: 1; grid-row: 9; margin-top: 16px; }
  }
</style>
