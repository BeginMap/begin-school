---
import '@fontsource-variable/rubik/wght.css';
import '@fontsource-variable/rubik/wght-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { LANGS, DIR, OG_LOCALE, t, href, abs, type Lang, type Page } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangSuggest from '../components/LangSuggest.astro';

import heW from '@fontsource-variable/rubik/files/rubik-hebrew-wght-normal.woff2?url';
import heI from '@fontsource-variable/rubik/files/rubik-hebrew-wght-italic.woff2?url';
import arW from '@fontsource-variable/rubik/files/rubik-arabic-wght-normal.woff2?url';
import cyW from '@fontsource-variable/rubik/files/rubik-cyrillic-wght-normal.woff2?url';
import cyI from '@fontsource-variable/rubik/files/rubik-cyrillic-wght-italic.woff2?url';
import laW from '@fontsource-variable/rubik/files/rubik-latin-wght-normal.woff2?url';
import laI from '@fontsource-variable/rubik/files/rubik-latin-wght-italic.woff2?url';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  fieldStart?: string;
  noindex?: boolean;
}
const { lang, page, title, description, fieldStart = 'hero', noindex = false } = Astro.props;
const d = t(lang);
const dir = DIR[lang];
const preload: Record<Lang, string[]> = {
  he: [heW, heI, laW],
  ar: [arW, laW],
  ru: [cyW, cyI, laW],
  en: [laW, laI],
};
const ogImage = new URL(`${import.meta.env.BASE_URL}og/og-${lang}.jpg`, import.meta.env.SITE).toString();
---
<!doctype html>
<html lang={lang} dir={dir} data-page={page || 'home'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(lang, page)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l, page)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('he', page)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang, page)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    {preload[lang].map((u) => <link rel="preload" href={u} as="font" type="font/woff2" crossorigin />)}
    {lang === 'he' && !noindex && (
      <script is:inline define:vars={{ base: import.meta.env.BASE_URL, sub: page }}>
        // a language the visitor chose before is remembered; the Hebrew root sends them back to it
        try {
          var l = localStorage.getItem('lang');
          if ((l === 'ar' || l === 'ru' || l === 'en') && !/[?&]he=1/.test(location.search)) location.replace(base + l + '/' + sub + location.hash);
        } catch (e) {}
      </script>
    )}
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var m = null;
        try { m = localStorage.getItem('motion'); } catch (e) {}
        var rm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        h.dataset.motion = m === 'off' || (m === null && rm) ? 'off' : 'on';
        if (/[?&]qa=1/.test(location.search)) h.classList.add('qa');
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.ui.skip}</a>
    <canvas id="field" aria-hidden="true" transition:persist="field"></canvas>
    <div class="field-still" aria-hidden="true" transition:persist="field-still"></div>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1" data-field-start={fieldStart} transition:animate="none">
      <slot />
    </main>
    <Footer lang={lang} />
    <LangSuggest lang={lang} page={page} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
